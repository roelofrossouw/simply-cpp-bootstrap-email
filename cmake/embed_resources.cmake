# Writes OUTPUT, a C++ file holding bootstrap-email's files below BASE as strings: sc::bootstrap_email::resource("<path below BASE>")
file(GLOB FILES ${BASE}/css/*.css ${BASE}/templates/*.html ${BASE}/layout.html ${BASE}/VERSION)
set(body "")
foreach (file ${FILES})
    file(RELATIVE_PATH name "${BASE}" "${file}")
    file(READ "${file}" content HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${content}")
    string(APPEND body "        {\"${name}\", []() { static constexpr char data[] = {${bytes}}; return std::string_view(data, sizeof data); }()},\n")
endforeach ()
file(WRITE "${OUTPUT}" "// Generated by cmake/embed_resources.cmake from third_party/bootstrap-email: don't edit.
#include \"resources.h\"

#include <map>
#include <stdexcept>
#include <string>

std::string_view sc::bootstrap_email::resource(const std::string_view name) {
    static const std::map<std::string, std::string_view, std::less<>> resources = {
${body}    };
    const auto found = resources.find(name);
    if (found == resources.end()) {
        throw std::logic_error(\"sc-bootstrap-email: no resource \" + std::string(name));
    }
    return found->second;
}
")
